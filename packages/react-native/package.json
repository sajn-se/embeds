{
    "name": "@sajn/embed-react-native",
    "version": "1.0.0-beta.2",
    "description": "Embed sajn e-signing in a React Native app",
    "homepage": "https://github.com/sajn-se/embeds#readme",
    "bugs": {
        "url": "https://github.com/sajn-se/embeds/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sajn-se/embeds.git"
    },
    "license": "MIT",
    "author": "sajn",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.cts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "clean": "rimraf node_modules && rimraf dist",
        "check-exports": "attw --pack .",
        "publint": "publint"
    },
    "devDependencies": {
        "@sajn/embed-js": "workspace:^",
        "@types/react": "^19.0.0",
        "react-native": "0.86.2",
        "react-native-webview": "13.16.1",
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.1.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-native": ">=0.74",
        "react-native-webview": ">=13"
    },
    "publishConfig": {
        "access": "public"
    }
}
