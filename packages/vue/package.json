{
    "name": "@sajn/embed-vue",
    "version": "1.0.0-beta.1",
    "description": "Vue component for embedded sajn e-signing",
    "homepage": "https://github.com/sajn-se/embeds#readme",
    "bugs": {
        "url": "https://github.com/sajn-se/embeds/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sajn-se/embeds.git"
    },
    "license": "MIT",
    "author": "sajn",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.cts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "clean": "rimraf node_modules && rimraf dist",
        "check-exports": "attw --pack .",
        "publint": "publint"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.0",
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.1.0",
        "vue": "^3.3.0"
    },
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@sajn/embed-js": "workspace:^"
    }
}
